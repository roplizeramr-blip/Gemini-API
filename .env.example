# Railway provides PORT automatically.

# Gateway authentication — REQUIRED
GATEWAY_API_KEY=generate-a-long-random-secret

# Gemini Web session — keep secrets only in Railway Variables
GEMINI_SECURE_1PSID=your-current-__Secure-1PSID-value
GEMINI_SECURE_1PSIDTS=your-current-__Secure-1PSIDTS-value

# Persistent Railway Volume
GEMINI_COOKIE_PATH=/data/gemini/cookies
GATEWAY_DATA_DIR=/data/gateway

# Optional
MAX_UPLOAD_MB=50
GEMINI_TIMEOUT=450
GEMINI_AUTO_REFRESH=true
GEMINI_REFRESH_INTERVAL=600
GEMINI_WATCHDOG_TIMEOUT=120
GEMINI_VERBOSE=false
GEMINI_PROXY=
CORS_ORIGINS=*
ALLOW_GUEST_SESSION=false
